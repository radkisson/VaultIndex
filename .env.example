# VaultIndex configuration — copy to .env and edit
# Source with:  export $(grep -v '^#' .env | xargs)

# REQUIRED: path to your Obsidian vault
VAULT_PATH=/path/to/your/vault

# ── Ollama ───────────────────────────────────────────────────────────────────
# Embedding server URL
# OLLAMA_URL=http://localhost:11434/api/embed

# Embedding model — any Ollama embedding model works
# nomic-embed-text   (768-dim, fast, default)
# mxbai-embed-large  (1024-dim, strong multilingual)
# bge-m3             (1024-dim, state-of-the-art)
# MODEL=nomic-embed-text

# ── Watch mode ───────────────────────────────────────────────────────────────
# Debounce window: wait this many seconds after the last write before
# re-embedding. Obsidian saves in bursts — too low = duplicate work.
# 1.0 = aggressive (embeds on every keystroke pause)
# 3.0 = balanced  (default, handles burst writes well)
# 5.0 = relaxed   (fewer embeds, longer lag)
# WATCH_DEBOUNCE_SEC=3.0

# Max seconds between batch flushes. Changes accumulate until either
# all files are settled (debounce expired) OR this deadline hits.
# 5.0  = snappy  (more frequent Ollama calls, faster feedback)
# 10.0 = default (balances freshness vs Ollama load)
# 30.0 = lazy    (fewer embeds, longer lag)
# WATCH_BATCH_SEC=10.0

# Table optimization frequency: compact Lancedb after every N batch flushes.
# Balances disk usage vs write amplification.
# WATCH_OPTIMIZE_EVERY=20

# ── Database ─────────────────────────────────────────────────────────────────
# Where Lancedb stores vectors. Default: ./lancedb (next to vault_db.py)
# DB_DIR=./lancedb

# ── Multiple vaults ──────────────────────────────────────────────────────────
# To index more than one vault, create separate instances with different
# DB_DIR values. Each vault gets its own LanceDB database — they don't mix.
#
#   Instance 1:  VAULT_PATH=/vaults/personal   DB_DIR=./lancedb-personal
#   Instance 2:  VAULT_PATH=/vaults/work        DB_DIR=./lancedb-work
#
# The same vault_db.py works for all of them — just change the env vars.